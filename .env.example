# --- API Laravel (OmniSaleApi) ---
# Obligatoire pour login / session / appels métier
# Ex prod: https://api-tekahub.niwytech.cloud
# Ex local: http://127.0.0.1:8000
API_BASE_URL=https://api-tekahub.niwytech.cloud

# --- Shell auto-update (electron-updater) ---
UPDATE_PROVIDER=github
GH_OWNER=niwy2025
GH_REPO=tekahub-desktop
# Si UPDATE_PROVIDER=generic :
UPDATE_URL=

# --- Packs (contenu dynamique) ---
PACKS_UPDATE_URL=
PACKS_PUBLIC_KEY=

# Dev: skip remote checks
# TEKA_SKIP_UPDATE_CHECK=1
# TEKA_SKIP_PACK_CHECK=1

# Dev: ouvrir DevTools au démarrage
# TEKA_OPEN_DEVTOOLS=1

# Linux désactive le GPU par défaut (évite GetVSync… dans le terminal).
# Pour forcer le GPU : TEKA_ENABLE_GPU=1
# Pour forcer soft render ailleurs : TEKA_DISABLE_GPU=1
