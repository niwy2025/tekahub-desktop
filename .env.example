# --- Shell auto-update (electron-updater) ---
# Provider: github | generic (S3/CDN)
UPDATE_PROVIDER=github

# GitHub releases (owner/repo that hosts shell installers)
GH_OWNER=your-org
GH_REPO=teka-desktop

# Generic / CDN base URL for latest.yml + installers
# Ex: https://cdn.example.com/teka-desktop
UPDATE_URL=

# --- Packs (contenu dynamique) ---
# Base URL where pack manifests + archives are hosted
# Ex: https://cdn.example.com/teka-packs
PACKS_UPDATE_URL=

# Ed25519 public key (hex or base64) embedded at build time — NEVER the private key
PACKS_PUBLIC_KEY=

# Optional: path to private key for signing (scripts only, never ship in app)
# PACKS_PRIVATE_KEY_PATH=./keys/packs-private.pem

# Dev: skip remote checks
# TEKA_SKIP_UPDATE_CHECK=1
# TEKA_SKIP_PACK_CHECK=1
